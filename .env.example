# Database (PostgreSQL — local Docker defaults shown as placeholders)
DATABASE_URL="postgresql://sagara:sagara_local_dev@localhost:5433/sagara_villas?schema=public"
DIRECT_URL="postgresql://sagara:sagara_local_dev@localhost:5433/sagara_villas?schema=public"

# Authentication (Auth.js — generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-at-least-32-bytes-of-random-entropy"
AUTH_URL="http://localhost:3000"

# Public site & Property configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
PROPERTY_TIMEZONE="Asia/Makassar"

# Seed credentials (required when running `npm run db:seed`; remove after seeding in production)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-strong-admin-password-min-12-chars"
SEED_STAFF_EMAIL="staff@example.com"
SEED_STAFF_PASSWORD="replace-with-strong-staff-password-min-12-chars"
ALLOW_PRODUCTION_SEED="false"

# Optional: Rate limiting store (Upstash Redis or leave empty to use Postgres fallback)
RATE_LIMIT_REDIS_URL=""
RATE_LIMIT_REDIS_TOKEN=""

# Optional: Post-submit demo WhatsApp contact number & Cloudflare Turnstile CAPTCHA
NEXT_PUBLIC_WHATSAPP_NUMBER=""
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

